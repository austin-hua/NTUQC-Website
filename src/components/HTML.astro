---
import type { HTMLAttributes } from "astro/types";

import Analytics from "@vercel/analytics/astro";

import "~/styles/globals.ts";

type Props = HTMLAttributes<"html"> & {
  title?: string;
  description?: string;
  image?: string;
};

const {
  title = "NTU Quantum Club",
  description = "Promoting quantum science and technology education, research collaboration, and community building at National Taiwan University.",
  image = "/og-image.png",
  ...html
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(image, Astro.site);
---

<!-- TODO : html data-theme = "light" or "dark" -->
<html lang="en" data-theme="dark" data-lang="en" {...html}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Apply a stored language preference before first paint to avoid a flash of the wrong language.
      (function () {
        try {
          var stored = localStorage.getItem("ntuqc-lang");
          if (stored === "en" || stored === "zh") {
            document.documentElement.dataset.lang = stored;
            document.documentElement.lang = stored === "zh" ? "zh-Hant" : "en";
          }
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/png" href="/fav.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NTU Quantum Club" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- TODO : fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Noto+Sans+TC:wght@400;500;700&family=Roboto+Mono:ital,wght@0,100..700;1,100..700&display=swap"
      rel="stylesheet"
    />

    <Analytics />

    <slot name="head" />
  </head>
  <body>
    <slot name="body" />
  </body>
</html>
