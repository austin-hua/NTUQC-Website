---
import { CURRENT_YEAR } from "~/data/staff.ts";
import { Lucide } from "~/components/icons";

type Props = {
  active: "home" | "team" | "collaborators";
};

const { active } = Astro.props;

const links = [
  { key: "home" as const, href: "/", label: "Home" },
  { key: "team" as const, href: `/team/${CURRENT_YEAR}/`, label: "Team" },
  { key: "collaborators" as const, href: "/collaborators/", label: "Collaborators" },
];

const eventLinks = [
  { href: "https://sqai.org", label: "Summit on Quantum AI (SQAI)" },
  { href: "https://quantum.ntu.edu.tw/?p=10004", label: "Qiskit Hackathon Taiwan" },
];

const navLinkClasses = [
  "px-4 h-8 inline-flex items-center border rounded-xl text-sm font-medium transition outline-none",
  "focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-neutral-7 focus-visible:ring-offset-neutral-1",
];

const inactiveClasses = "bg-neutral-2 hover:bg-neutral-3 border-neutral-4 hover:border-neutral-6 text-neutral-10 hover:text-neutral-11";
---

<nav class="flex items-center justify-center gap-2 py-4 flex-wrap">
  {
    links.map((link) => (
      <a href={link.href} class:list={[navLinkClasses, link.key === active ? "bg-primary-3 border-primary-6 text-primary-11" : inactiveClasses]}>
        {link.label}
      </a>
    ))
  }

  <details class="nav-events group relative">
    <summary class:list={[navLinkClasses, inactiveClasses, "gap-1 cursor-pointer select-none"]}>
      Events
      <Lucide.IconChevronDown size={14} className="transition group-open:rotate-180" />
    </summary>

    <div class="absolute left-1/2 top-full -translate-x-1/2 mt-2 z-10 flex flex-col gap-1 p-1 min-w-[220px] bg-neutral-2 border border-neutral-4 rounded-xl shadow-lg">
      {
        eventLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noreferrer"
            class="px-3 py-2 rounded-lg text-sm text-neutral-11 hover:bg-neutral-3 hover:text-primary-11 transition outline-none focus-visible:bg-neutral-3"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </details>
</nav>

<style>
  .nav-events summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  // Close the Events dropdown when clicking outside of it.
  document.addEventListener("click", (event) => {
    document.querySelectorAll<HTMLDetailsElement>(".nav-events[open]").forEach((details) => {
      if (!details.contains(event.target as Node)) details.open = false;
    });
  });
</script>
