---
import { CURRENT_YEAR } from "~/data/staff.ts";
import LangToggle from "~/components/LangToggle.astro";

type Props = {
  active: "home" | "team" | "partners" | "events";
};

const { active } = Astro.props;

const links = [
  { key: "home" as const, href: "/", label: { en: "Home", zh: "首頁" } },
  { key: "team" as const, href: `/team/${CURRENT_YEAR}/`, label: { en: "Team", zh: "團隊" } },
  { key: "partners" as const, href: "/partners/", label: { en: "Partners", zh: "合作夥伴" } },
  { key: "events" as const, href: "/events/", label: { en: "Events", zh: "活動" } },
];

const navLinkClasses = [
  "px-4 h-8 inline-flex items-center border rounded-xl text-sm font-medium transition outline-none",
  "focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-neutral-7 focus-visible:ring-offset-neutral-1",
];

const inactiveClasses = "bg-neutral-2 hover:bg-neutral-3 border-neutral-4 hover:border-neutral-6 text-neutral-10 hover:text-neutral-11";
---

<nav class="flex items-center justify-center gap-2 py-4 flex-wrap">
  {
    links.map((link) => (
      <a href={link.href} class:list={[navLinkClasses, link.key === active ? "bg-primary-3 border-primary-6 text-primary-11" : inactiveClasses]}>
        <span class="i18n-en">{link.label.en}</span>
        <span class="i18n-zh">{link.label.zh}</span>
      </a>
    ))
  }

  <LangToggle />
</nav>
