---
import MainLayout from "~/layouts/MainLayout.astro";

import Nav from "~/components/Nav.astro";
import Team from "~/components/Team.tsx";

import { CURRENT_YEAR, getStaffYear } from "~/data/staff.ts";

const staffYear = getStaffYear(CURRENT_YEAR)!;
---

<MainLayout
  title={`Team · ${staffYear.label} | NTU Quantum Club`}
  description={`Meet the NTU Quantum Club staff team for the ${staffYear.label}.`}
>
  <main class="container p-3 mx-auto max-w-screen-sm min-h-dvh">
    <Nav active="team" />

    <Team year={staffYear.year} client:idle />
  </main>
</MainLayout>
