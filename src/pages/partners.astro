---
import MainLayout from "~/layouts/MainLayout.astro";

import Nav from "~/components/Nav.astro";
---

<MainLayout title="Partners | NTU Quantum Club" description="Organizations and institutions partnering with NTU Quantum Club.">
  <main class="container p-3 mx-auto max-w-screen-sm min-h-dvh">
    <Nav active="partners" />

    <div class="flex flex-col items-center justify-center gap-2 px-3 py-24 text-center">
      <h1 class="font-medium text-2xl lg:text-3xl">Partners</h1>
      <p class="text-neutral-10 text-sm">Coming soon.</p>
    </div>
  </main>
</MainLayout>
