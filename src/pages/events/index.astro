---
import MainLayout from "~/layouts/MainLayout.astro";

import Nav from "~/components/Nav.astro";
import { Lucide } from "~/components/icons";

import { CURRENT_YEAR, getStaffYear } from "~/data/staff.ts";
import { EVENT_TYPES, PARTNER_EVENTS } from "~/data/events.ts";

const staffYear = getStaffYear(CURRENT_YEAR)!;

const EVENT_CALENDAR_ID = "1v0ILDKIC8IvJ3raQl3T4MTx41UbotZNmJNncp_-8sJo";
const EVENT_CALENDAR_GID = "921921177";
const EVENT_CALENDAR_URL = `https://docs.google.com/spreadsheets/d/${EVENT_CALENDAR_ID}/edit?gid=${EVENT_CALENDAR_GID}#gid=${EVENT_CALENDAR_GID}`;
const EVENT_CALENDAR_EMBED_URL = `https://docs.google.com/spreadsheets/d/${EVENT_CALENDAR_ID}/htmlview?gid=${EVENT_CALENDAR_GID}&widget=true&headers=false`;

// Width in pixels of the Google Sheet's columns as Google renders them. If the
// sheet gains or widens columns, raise this so the page's arrows reach them
// (until then, Google's own scrollbar appears inside the frame as a fallback).
const SHEET_WIDTH = 1720;

const arrowClasses = [
  "absolute top-1/2 -translate-y-1/2 flex items-center justify-center size-11 rounded-full",
  "bg-neutral-12 text-neutral-1 shadow-lg hover:scale-110 transition",
  "outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-neutral-7",
];

const cardClasses = [
  "group flex items-center justify-between px-4 py-3",
  "bg-neutral-2 hover:bg-neutral-3",
  "outline-none border border-neutral-4 hover:border-neutral-6 rounded-3xl",
  "focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-neutral-7 focus-visible:ring-offset-neutral-1",
];
---

<MainLayout
  title={`Events · ${staffYear.label.en} | NTU Quantum Club`}
  description={`NTU Quantum Club events for the ${staffYear.label.en}.`}
>
  <main class="container p-3 mx-auto max-w-screen-sm min-h-dvh">
    <Nav active="events" />

    <div class="flex flex-col gap-2 px-3 lg:px-6 pt-4 pb-3">
      <div class="flex items-center justify-between gap-3">
        <h2 class="font-medium text-xl">
          <span class="i18n-en">Event Calendar</span>
          <span class="i18n-zh">活動行事曆</span>
        </h2>
        <a
          href={EVENT_CALENDAR_URL}
          target="_blank"
          rel="noreferrer"
          class="flex items-center gap-1 text-sm text-neutral-10 hover:text-primary-11 transition"
        >
          <span class="i18n-en">Open in Google Sheets</span>
          <span class="i18n-zh">在 Google 試算表開啟</span>
          <Lucide.IconExternalLink size={16} />
        </a>
      </div>
      <p class="text-neutral-10 text-sm">
        <span class="i18n-en">Our schedule is updated regularly. Upcoming dates may change as details are confirmed.</span>
        <span class="i18n-zh">行事曆會定期更新，尚未舉行的活動日期可能依確認結果調整。</span>
      </p>
      <p class="flex items-center gap-2 text-primary-11 text-sm font-medium">
        <span aria-hidden="true">⇆</span>
        <span class="i18n-en">The calendar is wide. Scroll sideways or use the arrows to see every column.</span>
        <span class="i18n-zh">行事曆較寬，請左右滑動或點擊箭頭查看所有欄位。</span>
      </p>
    </div>

    <!-- Google's frame is cross-origin, so this page can't read or control its
         scroll position. Instead the iframe is rendered at the sheet's full
         width inside a scroll area this page owns, which lets the arrows and
         edge fades track and drive the scrolling. -->
    <div class="px-3 lg:px-6">
      <div class="relative overflow-hidden bg-[#fff] border border-neutral-4 rounded-3xl" data-calendar>
        <div
          class="overflow-x-auto overscroll-x-contain outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-neutral-7"
          tabindex="0"
          aria-label="Event calendar, scrolls sideways"
          data-calendar-scroller
        >
          <iframe
            src={EVENT_CALENDAR_EMBED_URL}
            title="NTUQC event calendar"
            class="block h-[36rem] max-w-none"
            style={`width: ${SHEET_WIDTH}px`}
          ></iframe>
        </div>

        <div
          class="pointer-events-none absolute inset-y-0 left-0 w-16 bg-gradient-to-r from-[rgba(17,17,19,0.3)] to-transparent opacity-0 transition-opacity"
          data-calendar-side="left"
        ></div>
        <div
          class="pointer-events-none absolute inset-y-0 right-0 w-16 bg-gradient-to-l from-[rgba(17,17,19,0.3)] to-transparent transition-opacity"
          data-calendar-side="right"
        ></div>

        <button
          type="button"
          aria-label="Scroll calendar left"
          class:list={[arrowClasses, "left-3 opacity-0 pointer-events-none"]}
          data-calendar-side="left"
          data-calendar-arrow="-1"
        >
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
        </button>
        <button
          type="button"
          aria-label="Scroll calendar right"
          class:list={[arrowClasses, "right-3"]}
          data-calendar-side="right"
          data-calendar-arrow="1"
        >
          <svg class="animate-nudge-right" data-calendar-nudge viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </button>
      </div>
    </div>

    <script>
      document.querySelectorAll<HTMLElement>("[data-calendar]").forEach((root) => {
        const scroller = root.querySelector<HTMLElement>("[data-calendar-scroller]")!;

        // Show each side's fade and arrow only while there is more to see there.
        const setVisible = (side: "left" | "right", visible: boolean) =>
          root.querySelectorAll<HTMLElement>(`[data-calendar-side="${side}"]`).forEach((el) => {
            el.classList.toggle("opacity-0", !visible);
            el.classList.toggle("pointer-events-none", !visible || el.tagName !== "BUTTON");
          });

        const update = () => {
          const max = scroller.scrollWidth - scroller.clientWidth;
          setVisible("left", scroller.scrollLeft > 4);
          setVisible("right", scroller.scrollLeft < max - 4);
        };

        root.querySelectorAll<HTMLButtonElement>("[data-calendar-arrow]").forEach((button) => {
          button.addEventListener("click", () => {
            const direction = Number(button.dataset.calendarArrow);
            scroller.scrollBy({ left: direction * scroller.clientWidth * 0.8, behavior: "smooth" });
          });
        });

        // Stop the attention nudge once the visitor has scrolled at all.
        scroller.addEventListener(
          "scroll",
          () => root.querySelector("[data-calendar-nudge]")?.classList.remove("animate-nudge-right"),
          { once: true }
        );
        scroller.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);
        update();
      });
    </script>

    <div class="flex flex-col gap-8 px-3 lg:px-6 py-8">
      <div>
        <h2 class="font-medium text-xl mb-1">
          <span class="i18n-en">What We Host</span>
          <span class="i18n-zh">活動類型</span>
        </h2>
        <p class="text-neutral-10 text-sm mb-3">
          <span class="i18n-en">Each semester, our events usually fall into these categories.</span>
          <span class="i18n-zh">每學期的活動大致分為以下幾類。</span>
        </p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 p-1">
          {
            EVENT_TYPES.map((type) => (
              <li class="flex flex-col gap-2 px-5 py-4 bg-neutral-2 border border-neutral-4 rounded-3xl">
                <h3 class="text-neutral-12 font-medium">
                  <span class="i18n-en">{type.title.en}</span>
                  <span class="i18n-zh">{type.title.zh}</span>
                </h3>
                <p class="text-neutral-11 text-sm">
                  <span class="i18n-en">{type.description.en}</span>
                  <span class="i18n-zh">{type.description.zh}</span>
                </p>
                <p class="text-neutral-10 text-xs">
                  <span class="i18n-en">Examples: {type.examples.en}</span>
                  <span class="i18n-zh">例如：{type.examples.zh}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-medium text-xl mb-3">
          <span class="i18n-en">Partner Events</span>
          <span class="i18n-zh">夥伴活動</span>
        </h2>
        <ul class="grid grid-cols-1 gap-3 p-1">
          {
            PARTNER_EVENTS.map((event) => (
              <li>
                <a href={event.href} target="_blank" rel="noreferrer" class:list={cardClasses}>
                  <div class="flex flex-row items-center gap-5 pl-2">
                    <div class="flex items-center justify-center h-12 shrink-0">
                      {event.image ? (
                        <img src={event.image} alt="" class="h-full w-auto max-w-[80px] object-contain rounded-md" />
                      ) : (
                        <Lucide.IconGlobe
                          size={24}
                          className="transition duration-300 group-hover:-translate-y-1 text-neutral-10 group-hover:text-neutral-11"
                        />
                      )}
                    </div>

                    <div>
                      <h3 class="transition duration-300 group-hover:translate-x-1 text-neutral-12 text-sm">{event.title}</h3>
                      <div class="transition duration-300 group-hover:translate-x-px text-neutral-10 group-hover:text-neutral-11 text-xs">
                        <span class="i18n-en">{event.description.en}</span>
                        <span class="i18n-zh">{event.description.zh}</span>
                      </div>
                    </div>
                  </div>

                  <Lucide.IconExternalLink aria-label="Open" className="transition text-neutral-10 group-hover:text-primary-11" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </main>
</MainLayout>
