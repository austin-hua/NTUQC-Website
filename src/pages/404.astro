---
import MainLayout from "~/layouts/MainLayout.astro";

import { Separator } from "~/components/ui";
---

<MainLayout>
  <main class="flex items-center justify-center w-dvw h-dvh overflow-hidden">
    <h1 class="flex items-center font-mono text-xl">
      404
      <Separator color="primary" orientation="vertical" className="mx-4 w-1 h-10" />
      <span class="i18n-en">Page not found</span>
      <span class="i18n-zh">找不到頁面</span>
    </h1>
  </main>
</MainLayout>
